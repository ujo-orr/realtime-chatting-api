map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Authorization·Cookie·쿼리를 남기지 않는 연결 관찰 로그
log_format transport '$time_iso8601 method=$request_method uri=$uri status=$status '
    'tls=$ssl_protocol cipher=$ssl_cipher upgrade=$http_upgrade '
    'upstream=$upstream_status elapsed=$request_time';

server {
    listen 80;
    server_name localhost 127.0.0.1;
    access_log /var/log/nginx/access.log transport;
    return 308 https://localhost:${TLS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    server_name localhost 127.0.0.1;
    access_log /var/log/nginx/access.log transport;
    ssl_certificate /etc/nginx/tls/server.crt;
    ssl_certificate_key /etc/nginx/tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Port ${TLS_PORT};
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Prefix "";
    proxy_connect_timeout 5s;

    location = /ws {
        proxy_pass http://app:8080;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port ${TLS_PORT};
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 60s;
    }

    location = /api/notifications/stream {
        proxy_pass http://app:8080;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout ${SSE_PROXY_READ_TIMEOUT};
    }

    location / {
        proxy_pass http://app:8080;
        proxy_read_timeout 60s;
    }
}
